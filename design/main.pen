                                  "type": "text",
                                  "id": "Dhjs6",
                                  "name": "Tok",
                                  "fill": "$ink",
                                  "content": "    glob = torch.zeros_like(local)",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 22,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
