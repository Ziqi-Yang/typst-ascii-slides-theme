                              "children": [
                                {
                                  "type": "text",
                                  "id": "ldvNs",
                                  "name": "Tok",
                                  "fill": "$ink",
                                  "content": "    idx = torch.arange(n_blocks)",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 22,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
