                                {
                                  "type": "text",
                                  "id": "M7ihig",
                                  "name": "Tok",
                                  "fill": "$ink",
                                  "content": "    dist = (idx[:, None] - idx[None, :]).abs()",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 22,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "T1Njpu",
                              "name": "Line",
