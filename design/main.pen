                                  "type": "text",
                                  "id": "iXOo8",
                                  "name": "Tok",
                                  "fill": "$ok",
                                  "content": "\"\"\"Block-sparse mask: local window + global.\"\"\"",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 22,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
