                                {
                                  "type": "text",
                                  "id": "yTgMq",
                                  "name": "Tok",
                                  "fill": "$ink",
                                  "content": "    local = dist <= window",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 22,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
